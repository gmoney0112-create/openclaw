# === Required ===
ANTHROPIC_API_KEY=sk-ant-...           # claude.ai → Settings → API Keys ($20/mo)

# === Transcription ===
OPENAI_API_KEY=sk-...                  # platform.openai.com → API Keys (Whisper)

# === Research & Scraping ===
APIFY_API_KEY=apify_api_...            # console.apify.com → Settings → Integrations

# === AI Video Generation ===
HIGGSFIELD_API_KEY=hf_...              # higgsfield.ai → Dashboard → API ($15/mo)

# === Email ===
RESEND_API_KEY=re_...                  # resend.com → API Keys
RESEND_FROM_EMAIL=you@yourdomain.com   # verified sender domain in Resend

# === Content Calendar ===
NOTION_API_KEY=secret_...             # notion.so → Settings → Connections → New integration
NOTION_CALENDAR_DATABASE_ID=...       # 32-char ID from your Notion database URL

# === Landing Pages ===
VERCEL_TOKEN=...                       # vercel.com → Settings → Tokens
VERCEL_ORG_ID=...                      # vercel.com → Settings → General
VERCEL_PROJECT_NAME=content-landing

# === Output ===
OUTPUT_DIR=./output
ANTHROPIC_MODEL=claude-opus-4-8
